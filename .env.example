# ==========================================
# MATRIX: Environment Configuration Example
# ==========================================

# Core Application Settings
MATRIX_ENV=development
MATRIX_APP_NAME=MATRIX
MATRIX_VERSION=1.0.0
MATRIX_DEBUG=true

# Storage and Directories (Default to D:\matrix_data to preserve C: OS drive)
MATRIX_DATA_DIR=D:\matrix_data
MATRIX_DATABASE_URL=sqlite+aiosqlite:///D:/matrix_data/matrix.db
MATRIX_MODELS_DIR=D:\matrix_data\models
MATRIX_CACHE_DIR=D:\matrix_data\cache
MATRIX_LOGS_DIR=logs

# Network & API
MATRIX_HOST=127.0.0.1
MATRIX_PORT=8000
MATRIX_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
MATRIX_SECRET_KEY=matrix_dev_super_secret_key_change_in_production_32char_min

# Hardware Optimization Profile
MATRIX_CPU_CORES=8
MATRIX_CPU_THREADS=16
MATRIX_AVX2_ENABLED=true
MATRIX_LOW_RAM_MODE=true
MATRIX_MAX_RAM_PERCENT=85.0

# Local AI Models (Candidate: Qwen2.5 1.5B Q4_K_M)
MATRIX_LOCAL_MODEL_NAME=qwen2.5-1.5b-instruct
MATRIX_LOCAL_MODEL_PATH=D:\matrix_data\models\qwen2.5-1.5b-instruct-q4_k_m.gguf
MATRIX_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional Cloud AI Providers (Leave empty for pure local offline mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
FREE_LLM_API_ENDPOINT=

# Voice Configuration
MATRIX_WAKE_WORD=hey_matrix
MATRIX_SPEECH_LANGUAGE=en
MATRIX_TTS_VOICE=en_US-lessac-medium

# Security
MATRIX_SECURITY_LEVEL=3
MATRIX_REQUIRE_APPROVAL_HIGH_RISK=true
