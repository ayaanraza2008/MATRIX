# ==========================================
# MATRIX: Environment Configuration Example
# Copy to `.env` and edit. Never commit `.env`.
# ==========================================

# Core Application Settings
MATRIX_ENV=development
MATRIX_APP_NAME=MATRIX
MATRIX_VERSION=1.0.0
MATRIX_DEBUG=false          # keep false unless actively debugging: errors must not leak internals

# Storage and Directories
# Leave MATRIX_DATA_DIR unset to auto-resolve: D:\matrix_data when that drive is writable,
# otherwise <repository>/data. Set it explicitly to pin a location (e.g. an external SSD).
# MATRIX_DATA_DIR=D:\matrix_data
# MATRIX_DATABASE_URL=sqlite+aiosqlite:///D:/matrix_data/matrix.db
# MATRIX_MODELS_DIR=D:\matrix_data\models
# MATRIX_CACHE_DIR=D:\matrix_data\cache
# MATRIX_LOGS_DIR=D:\matrix_data\logs

# Network & API
MATRIX_HOST=127.0.0.1       # set 0.0.0.0 only together with MATRIX_API_TOKEN
MATRIX_PORT=8000
MATRIX_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]

# Security (read this section before exposing MATRIX to your LAN)
# Shared bearer token required from any non-loopback client (Android companion, LAN devices).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MATRIX_API_TOKEN=
# Code execution endpoints (/api/v1/developer/*) stay disabled unless explicitly enabled.
MATRIX_DEVELOPER_MODE=false
# Hosts allowed to reach privileged endpoints without a token (loopback is always trusted).
MATRIX_TRUSTED_HOSTS=["127.0.0.1", "::1", "localhost"]
MATRIX_SECRET_KEY=replace_with_a_random_32char_minimum_value
MATRIX_SECURITY_LEVEL=3
MATRIX_REQUIRE_APPROVAL_HIGH_RISK=true

# Hardware profile: leave unset to auto-detect the host CPU/RAM.
# Set only to pin a profile for benchmarking.
# MATRIX_CPU_CORES=8
# MATRIX_CPU_THREADS=16
# MATRIX_AVX2_ENABLED=true
# MATRIX_LOW_RAM_MODE=true
MATRIX_MAX_RAM_PERCENT=85.0

# Local AI Models (candidate: Qwen2.5 1.5B Q4_K_M for 8 GB CPU-only hosts)
MATRIX_LOCAL_MODEL_NAME=qwen2.5-1.5b-instruct
# MATRIX_LOCAL_MODEL_PATH=D:\matrix_data\models\qwen2.5-1.5b-instruct-q4_k_m.gguf
MATRIX_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional Cloud AI Providers (leave empty for pure local offline mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
FREE_LLM_API_ENDPOINT=

# Voice Configuration
MATRIX_WAKE_WORD=hey_matrix
MATRIX_SPEECH_LANGUAGE=en
MATRIX_TTS_VOICE=en_US-lessac-medium

# Telephony: Bland AI (autonomous AI voice calling)
BLAND_API_KEY=
BLAND_API_BASE_URL=https://api.bland.ai
# Configure your own number here; MATRIX refuses to call unverified numbers.
BLAND_TARGET_PHONE=
# Bland does not sign its callbacks. Set a shared secret and configure the same value
# on the webhook URL in the Bland dashboard (?secret=...). Unset = webhook is refused.
MATRIX_BLAND_WEBHOOK_SECRET=
